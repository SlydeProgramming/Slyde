class Test {

    int one(){
        return 1;
    }

    void wtf(){
        print("man why are you doing this to me");
    }

    String bobby(){
        return "bobby";
    }
}

main(){
    print("Hello World!");

    Test test = new Test();

    int here = test.one();

    if (here == 1){
        int lol = 99 + 12 - 56;
        print(test.bobby());
        print(lol);
        print("you need help man");
        print("I need help"); 
        print(false);  
    }

}
